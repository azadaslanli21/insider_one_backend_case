# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=football
DB_PASSWORD=football
DB_NAME=football_simulator

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── External API ──────────────────────────────────────────────────────────────
# Free API key from https://www.football-data.org/client/register
# Used ONCE at POST /league/init to fetch real PL standings for S_base derivation.
# If left empty, the simulator falls back to hardcoded strength values.
FOOTBALL_DATA_API_KEY=your_api_key_here
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
